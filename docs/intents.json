{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "app": "coddy",
  "description": "Coddy Intent Knowledge Graph - Central Registry of System Intents",
  "intent_types": {
    "cli_interface": {
      "pattern": "<CLI command> CALLS <handling function/method>",
      "description": "User-facing command line interface commands and subcommands mapped to their handling Python functions."
    },
    "agent_workflow": {
      "pattern": "<Orchestrating agent> USES <Worker agent> | <DecisionNode/Router> CALLS_IF <Target Node>",
      "description": "Orchestrator graph workflow routing, worker agent dispatch invocations, and decision node (:DecisionNode, :Router) conditional branching (CALLS_IF) documenting logical text."
    },
    "tool_usage": {
      "pattern": "<Worker agent> USES <Tool> CALLS <handling function/method>",
      "description": "Specialized worker agent tool invocations resolving to internal tool provider handling methods."
    },
    "database_operation": {
      "pattern": "<function/method> READS/CREATES/UPDATES/DELETES <Database <object>>",
      "description": "Operations performed on embedded in-memory database engines (FalkorDB Cypher graphs and Qdrant sparse vector collections)."
    },
    "file_io": {
      "pattern": "<function/method> READS/CREATES/UPDATES/DELETES <file>",
      "description": "Filesystem input/output operations including GraphRAG commit caches, structured artifacts, and execution session traces."
    },
    "external_api": {
      "pattern": "<Caller> CALLS <External Service/API>",
      "description": "Network and local HTTP service requests targeting LLM inference engines and search endpoints."
    },
    "callback_dispatch": {
      "pattern": "<Provider> INJECTS <Callback> INTO <Consumer>",
      "description": "Dynamic dependency injections, interactive terminal callbacks, and approval gate hooks."
    },
    "artifact_transformation": {
      "pattern": "<Mapper> TRANSFORMS <Source Schema> INTO <Target Document>",
      "description": "Deterministic Pydantic schema mappers converting JSON data models into human-readable Markdown documents (Rule R2)."
    }
  },
